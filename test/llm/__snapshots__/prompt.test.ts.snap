// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`prompt snapshots > matches the English prompt 1`] = `
"Write the lead of a daily digest of the following RSS entries from "Example Feed".
Write 2-3 sentences saying what the day was about, as one paragraph of plain prose.
Do not summarize the entries one by one: the reader sees every title listed under the lead. Use no bullets, entry numbers, headings or markup.
Use only the entries listed below. Never add information they do not carry, and never write a url.
Covering the 2 of 5 most recent entries.

1. Entry 1
URL: https://example.com/1
Excerpt: Snippet 1
2. (untitled)
URL: https://example.com/2
Excerpt: Body 2"
`;

exports[`prompt snapshots > matches the Japanese prompt 1`] = `
"次の「Example Feed」の RSS エントリから、日次ダイジェストのリード文を書いてください。
その日の全体像を 2〜3 文でまとめ、1 段落の平文で書いてください。
エントリを 1 件ずつ要約しないでください。読者にはリード文の下に全エントリの見出しが表示されます。箇条書き、エントリ番号、見出し、マークアップは使わないでください。
下に挙げたエントリの情報だけを使ってください。書かれていない情報を補ったり、URL を書いたりしないでください。
エントリの原文が英語であっても、リード文は日本語で書いてください。
全 5 件のうち、新しい方から 2 件を対象とします。

1. Entry 1
URL: https://example.com/1
Excerpt: Snippet 1
2. (タイトルなし)
URL: https://example.com/2
Excerpt: Body 2"
`;

exports[`prompt snapshots > matches the system prompts 1`] = `
{
  "en": "You are an editor who writes short, factual daily digests of RSS feeds. Answer with the lead only, without preamble.",
  "ja": "あなたは RSS フィードの日次ダイジェストを簡潔かつ事実に忠実にまとめる編集者です。前置きや後書きを付けず、リード文だけを日本語で出力してください。",
}
`;
